# 移动端（Capacitor / Android）构建配置
#
# ⚠️ 必须使用**绝对地址**：App 内页面来源是 http://localhost，
#    相对路径 /api/v1 会请求到 WebView 自身，导致所有接口失败。
#
# 这里的值只是「默认值」：App 内「服务器设置」可运行时覆盖，
# 因此换网络/换穿透域名**不需要重新打包**。
#
# 建议每次打包前用脚本显式指定，不要改这一行：
#   .\build-apk.ps1 -ApiBase http://你的IP:8080
# 查本机 IP：ipconfig | findstr IPv4

VITE_APP_TITLE=植语助手 GreenThumb AI
VITE_API_BASE=http://10.202.41.210:8080/api/v1
VITE_USE_MOCK=false
