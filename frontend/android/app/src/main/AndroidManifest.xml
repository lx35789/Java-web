<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        相机权限：应用内相机（getUserMedia）需要它。

        调用链：
          CameraCapture.vue → navigator.mediaDevices.getUserMedia()
          → WebView → BridgeWebChromeClient.onPermissionRequest
          → 看到 resource.VIDEO_CAPTURE → 申请 Manifest.permission.CAMERA

        注意：这里**必须声明**。若未声明，Capacitor 的 permissionLauncher
        无权限可申请，WebView 的 PermissionRequest 不会被 grant，
        getUserMedia 直接 reject（NotAllowedError），用户只会看到
        「相机权限被拒绝」，而在系统设置里根本找不到这个 App 的相机开关。

        历史背景（为何曾经删过）：早期用 input[type=file][capture] 走系统相机，
        那种路径下 hasDefinedPermission(CAMERA) 为 true 但未授权时，
        Capacitor 会静默 onReceiveValue(null)，表现为点拍照毫无反应。
        现在相机完全由应用内组件接管，不再依赖 input[capture]，
        声明 CAMERA 只有好处。

        从相册选取走系统文件选择器（SAF），不需要 READ_MEDIA_IMAGES。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
